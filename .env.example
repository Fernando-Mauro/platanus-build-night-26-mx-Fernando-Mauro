# Copy to .env.local for local development (.env.local is gitignored).
# In AWS these values come from Secrets Manager at runtime — never commit real secrets.

# App database (matches docker-compose.dev.yml `db` service)
DATABASE_URL="postgresql://vertice:vertice@localhost:5432/vertice?schema=public"

# Judge0 (matches docker-compose.dev.yml `judge0-server`)
JUDGE0_URL="http://localhost:2358"
JUDGE0_AUTHN_TOKEN="dev-local-judge0-token"

# Auth.js session secret (generate one: `openssl rand -base64 32`)
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
