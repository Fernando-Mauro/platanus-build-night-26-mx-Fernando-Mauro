// Walking-skeleton schema (T004). The full model (data-model.md / schema.dbml)
// is built in Phase 3 (T022). For now this is enough to prove DB connectivity.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; "debian-openssl-3.0.x" for the Node 22 bookworm
  // container (ECS Fargate). Without the second target the deployed query engine
  // is missing and DB calls fail at runtime.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Trivial table so migrations have something to create; the /api/ping endpoint
/// uses a raw `SELECT 1` and does not depend on this model.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())

  @@map("health_check")
}
